{
  "name": "waketime",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "清醒时光 - 记录清醒时间的安卓应用",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:property": "vitest run tests/property",
    "test:differential": "node scripts/require-baseline.mjs && node scripts/differential.mjs",
    "test:differential:self": "node scripts/require-baseline.mjs && node scripts/differential.mjs --self-test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:check": "depcruise src tests --config .dependency-cruiser.mjs && node scripts/arch-selftest.mjs",
    "arch:strict": "node scripts/arch-strict.mjs && node scripts/arch-selftest.mjs",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:strict": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run arch:check && npm test",
    "verify": "npm run typecheck && npm run lint:strict && npm run arch:strict && npm run format:check && npm test && npm run test:property && npm run test:differential:self && npm run test:differential && npm run test:e2e:strict",
    "cap:sync": "cap sync android",
    "android": "cap open android",
    "postinstall": "node scripts/patch-vite.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "8.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
